{{!< default}}

{{#post}}
<article class="container page">
    {{#if @page.show_title_and_feature_image}}
        <header class="page-head">
            <h1 class="page-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-sub">{{custom_excerpt}}</p>{{/if}}
        </header>
        {{#if feature_image}}
            <figure class="article-hero"><img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="lazy" onerror="this.closest('.article-hero').remove()" /></figure>
        {{/if}}
    {{/if}}
    <div class="gh-content">
        {{content}}
    </div>
</article>
{{/post}}
