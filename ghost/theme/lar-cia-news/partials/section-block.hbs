{{!-- Bloco de uma editoria na home. Params: slug, titulo. --}}
<section class="section-block">
    <div class="section-head">
        <h2 class="section-title"><a href="{{@site.url}}/tag/{{slug}}/">{{titulo}}</a></h2>
        <a class="section-more" href="{{@site.url}}/tag/{{slug}}/">Ver tudo →</a>
    </div>
    {{#get "posts" filter=filter limit="4" order="published_at desc" as |items|}}
        {{#if items}}
            <div class="section-grid">
                {{#foreach items}}
                    {{> article-card size="compact"}}
                {{/foreach}}
            </div>
        {{else}}
            <p class="section-empty">Ainda não há matérias publicadas nesta editoria.</p>
        {{/if}}
    {{/get}}
</section>
