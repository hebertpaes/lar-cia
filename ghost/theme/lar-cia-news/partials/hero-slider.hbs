{{!-- Slider principal: mostra os posts FIXADOS (Featured). "Fixe" no Ghost a
      matéria que deve aparecer aqui. Sem fixados, mostra as mais recentes.
      O slider usa só os fixados e "Últimas" usa os não-fixados → sem repetição.
      Quantidade: Design → slides_home (3 a 10). --}}
<section class="hero-slider" data-autoplay="5000" aria-label="Destaques">
    {{#get "posts" filter="featured:true+tag:-hash-ad" limit=@custom.slides_home order="published_at desc" as |slides|}}
        {{#if slides}}
            <div class="slider-track">{{#foreach slides}}{{> slide}}{{/foreach}}</div>
            <button class="slider-arrow prev" type="button" aria-label="Anterior">‹</button>
            <button class="slider-arrow next" type="button" aria-label="Próximo">›</button>
            <div class="slider-controls">
                <button class="slider-pause" type="button" aria-label="Pausar ou retomar">⏸</button>
                <div class="slider-dots">{{#foreach slides}}<button class="slider-dot{{#if @first}} active{{/if}}" type="button" data-go="{{@index}}" aria-label="Slide {{@number}}"></button>{{/foreach}}</div>
            </div>
        {{else}}
            {{#get "posts" filter="tag:-hash-ad" limit=@custom.slides_home order="published_at desc" as |slides|}}
                <div class="slider-track">{{#foreach slides}}{{> slide}}{{/foreach}}</div>
                <button class="slider-arrow prev" type="button" aria-label="Anterior">‹</button>
                <button class="slider-arrow next" type="button" aria-label="Próximo">›</button>
                <div class="slider-controls">
                    <button class="slider-pause" type="button" aria-label="Pausar ou retomar">⏸</button>
                    <div class="slider-dots">{{#foreach slides}}<button class="slider-dot{{#if @first}} active{{/if}}" type="button" data-go="{{@index}}" aria-label="Slide {{@number}}"></button>{{/foreach}}</div>
                </div>
            {{/get}}
        {{/if}}
    {{/get}}
</section>
