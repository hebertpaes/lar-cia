{{!-- Menu de navegação: vem 100% do Ghost Admin (Settings → Navigation).
      Desktop: barra horizontal de editorias. Mobile: dropdown moderno que abre
      pelo botão ☰ do cabeçalho. O toggle é INLINE (abaixo) de propósito — assim
      o menu funciona mesmo que o main.js falhe ou demore a carregar. --}}
<nav class="main-nav" aria-label="Editorias">
    <div class="container">
        <div class="nav-collapse" id="mainNav">
            <ul class="nav-list">
                {{#foreach navigation}}
                    <li class="{{#if current}}active{{/if}}"><a href="{{url}}">{{label}}</a></li>
                {{else}}
                    {{!-- Menu padrão EMBUTIDO: aparece automaticamente quando a
                         Navigation do Ghost está vazia, garantindo que o menu NUNCA
                         some. Se você preencher Settings → Navigation, o seu menu
                         passa a valer no lugar deste. --}}
                    {{!-- FALLBACK-NAV-START --}}
                    <li><a href="{{@site.url}}/">Início</a></li>
                    <li><a href="{{@site.url}}/tag/politica/">Política</a></li>
                    <li><a href="{{@site.url}}/tag/brasil-mundo/">Brasil</a></li>
                    <li><a href="{{@site.url}}/tag/economia/">Economia</a></li>
                    <li><a href="{{@site.url}}/tag/internacional/">Mundo</a></li>
                    <li><a href="{{@site.url}}/tag/esportes/">Esporte</a></li>
                    <li><a href="{{@site.url}}/tag/cidades/">Cidades</a></li>
                    <li><a href="{{@site.url}}/tag/policia/">Polícia</a></li>
                    <li><a href="{{@site.url}}/tag/cultura/">Variedades</a></li>
                    {{!-- FALLBACK-NAV-END --}}
                {{/foreach}}
                {{#foreach secondary_navigation}}
                    <li class="nav-sec {{#if current}}active{{/if}}"><a href="{{url}}">{{label}}</a></li>
                {{/foreach}}
            </ul>

            <div class="nav-extra">
                <div class="nav-auth">
                    <a class="nav-login" href="#/portal/signin" data-portal="signin">Entrar</a>
                    <a class="btn-subscribe" href="#/portal/signup" data-portal="signup">Assinar grátis</a>
                </div>
                {{> social}}
            </div>
        </div>
    </div>
</nav>
<script>
/* Toggle do menu mobile — autossuficiente (não depende do main.js). */
(function () {
    var burger = document.getElementById("navBurger");
    var nav = document.getElementById("mainNav");
    if (!burger || !nav) return;
    function set(open) {
        nav.classList.toggle("open", open);
        burger.setAttribute("aria-expanded", String(open));
        burger.innerHTML = open ? "✕" : "☰"; /* ✕ / ☰ */
    }
    burger.addEventListener("click", function (e) {
        e.preventDefault();
        set(!nav.classList.contains("open"));
    });
    nav.addEventListener("click", function (e) {
        if (e.target && e.target.closest && e.target.closest("a")) set(false);
    });
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" || e.keyCode === 27) set(false);
    });
    window.addEventListener("resize", function () {
        if (window.innerWidth >= 960) set(false);
    });
})();
</script>
