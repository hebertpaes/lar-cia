{{!-- Bloco "AO VIVO" da barra lateral. Configure o vídeo em
      Settings → Design → youtube_live_id (ID do vídeo/transmissão do YouTube).
      Sem ID, mostra um chamariz com link para o canal. --}}
<aside class="live-box" aria-label="Ao vivo">
    <h2 class="rail-title rail-live"><span class="live-dot"></span> AO VIVO</h2>
    {{#if @custom.youtube_live_id}}
        <div class="live-embed">
            <iframe src="https://www.youtube.com/embed/{{@custom.youtube_live_id}}?rel=0&mute=1"
                title="Transmissão ao vivo" loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
        </div>
    {{else}}
        <a class="live-placeholder" href="{{#if @custom.youtube_canal}}{{@custom.youtube_canal}}{{else}}https://www.youtube.com/tvassembleiamt{{/if}}" target="_blank" rel="noopener">
            <span class="live-badge"><span class="live-dot"></span> AO VIVO</span>
            <strong>Assista à transmissão ao vivo</strong>
            <small>Cole o ID do vídeo do YouTube em Design → youtube_live_id</small>
        </a>
    {{/if}}
</aside>
