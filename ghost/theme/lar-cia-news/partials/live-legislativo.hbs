{{!-- AO VIVO — sessões legislativas (nos três portais). Seletor entre os canais
      OFICIAIS no YouTube: ALMT, Câmara dos Deputados, Senado e Câmara de Cuiabá.
      Em vez de embutir a transmissão direto (que fica PRETA/"indisponível" fora de
      sessão), mostra um POSTER por canal — miniatura SEMPRE visível, com o
      agendamento das sessões — e só carrega o vídeo ao clicar. Se o portal tiver um
      canal geral (Design → youtube_canal_id), ele entra como 1ª aba "AO VIVO". --}}
<aside class="live-box live-leg" aria-label="Sessões ao vivo">
    <h2 class="rail-title rail-live"><span class="live-dot"></span> AO VIVO</h2>
    <div class="leg-tabs" role="tablist" aria-label="Canais ao vivo">
        {{#if @custom.youtube_canal_id}}<button class="leg-tab active" type="button" data-ch="{{@custom.youtube_canal_id}}" data-name="Ao vivo" data-sched="transmissão do canal">AO VIVO</button>{{/if}}
        <button class="leg-tab{{#unless @custom.youtube_canal_id}} active{{/unless}}" type="button" data-ch="UCIxlLEYzjWPLb_CXpc-e74w" data-name="ALMT · Assembleia de MT" data-sched="sessões em geral ter–qui">ALMT</button>
        <button class="leg-tab" type="button" data-ch="UC-ZkSRh-7UEuwXJQ9UMCFJA" data-name="Câmara dos Deputados" data-sched="sessões em geral ter–qui">Câmara</button>
        <button class="leg-tab" type="button" data-ch="UCLgti7NuK0RuW9wty-fxPjQ" data-name="Senado Federal" data-sched="sessões em geral ter–qui">Senado</button>
        <button class="leg-tab" type="button" data-ch="UCNCoIaMma_H-aFP6rRNb56w" data-name="Câmara de Cuiabá" data-sched="sessões em geral ter e qua">Câmara Cuiabá</button>
    </div>
    <div class="live-embed live-stage" id="legStage">
        <a class="live-poster" data-ch="{{#if @custom.youtube_canal_id}}{{@custom.youtube_canal_id}}{{else}}UCIxlLEYzjWPLb_CXpc-e74w{{/if}}" href="https://www.youtube.com/channel/{{#if @custom.youtube_canal_id}}{{@custom.youtube_canal_id}}{{else}}UCIxlLEYzjWPLb_CXpc-e74w{{/if}}/live" target="_blank" rel="noopener">
            <span class="live-badge"><span class="live-dot"></span> AO VIVO</span>
            <span class="live-poster-name">{{#if @custom.youtube_canal_id}}Ao vivo{{else}}ALMT · Assembleia de MT{{/if}}</span>
            <span class="live-play">▶</span>
            <span class="live-cta">Assistir · {{#if @custom.youtube_canal_id}}transmissão do canal{{else}}sessões em geral ter–qui{{/if}}</span>
        </a>
    </div>
    <a class="live-yt-fallback" id="legLink" href="https://www.youtube.com/channel/{{#if @custom.youtube_canal_id}}{{@custom.youtube_canal_id}}{{else}}UCIxlLEYzjWPLb_CXpc-e74w{{/if}}/live" target="_blank" rel="noopener">Ver a agenda de sessões no YouTube ↗</a>
</aside>
<script>
(function () {
    var stage = document.getElementById('legStage'), link = document.getElementById('legLink');
    if (!stage) return;
    var tabs = document.querySelectorAll('.leg-tab');
    var origin = '{{@site.url}}';
    function liveUrl(ch) { return 'https://www.youtube.com/channel/' + encodeURIComponent(ch) + '/live'; }
    // Carrega o vídeo só no clique — via DOM (sem innerHTML), com o canal codificado.
    function loadEmbed(ch) {
        var f = document.createElement('iframe');
        f.className = 'live-frame';
        f.src = 'https://www.youtube.com/embed/live_stream?channel=' + encodeURIComponent(ch) +
            '&autoplay=1&mute=1&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1&origin=' + encodeURIComponent(origin);
        f.title = 'Transmissão ao vivo';
        f.loading = 'lazy';
        f.allowFullscreen = true;
        f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        stage.textContent = '';
        stage.appendChild(f);
    }
    function span(cls, text) { var s = document.createElement('span'); s.className = cls; if (text != null) s.textContent = text; return s; }
    function showChannel(ch, name, sched) {
        var a = document.createElement('a');
        a.className = 'live-poster';
        a.href = liveUrl(ch); a.target = '_blank'; a.rel = 'noopener';
        a.setAttribute('data-ch', ch);
        var badge = span('live-badge'); badge.appendChild(span('live-dot')); badge.appendChild(document.createTextNode(' AO VIVO'));
        a.appendChild(badge);
        a.appendChild(span('live-poster-name', name));
        a.appendChild(span('live-play', '▶'));
        a.appendChild(span('live-cta', 'Assistir · ' + sched));
        a.addEventListener('click', function (e) { e.preventDefault(); loadEmbed(ch); });
        stage.textContent = '';
        stage.appendChild(a);
        if (link) link.href = liveUrl(ch);
    }
    tabs.forEach(function (t) {
        t.addEventListener('click', function () {
            tabs.forEach(function (x) { x.classList.remove('active'); });
            t.classList.add('active');
            showChannel(t.getAttribute('data-ch'), t.getAttribute('data-name') || t.textContent, t.getAttribute('data-sched') || '');
        });
    });
    // Poster inicial já vem no HTML (Handlebars, com escape): só liga o clique.
    var init = stage.querySelector('.live-poster');
    if (init) init.addEventListener('click', function (e) { e.preventDefault(); loadEmbed(init.getAttribute('data-ch')); });
})();
</script>
