{{!-- AO VIVO — sessões legislativas (nos três portais). Seletor entre os canais
      OFICIAIS no YouTube: ALMT, Câmara dos Deputados, Senado e Câmara de Cuiabá.
      Carrega o embed SEM autoplay → o YouTube exibe a PRÉVIA/thumbnail da sessão
      (com o ▶); o leitor clica para assistir. Assim não fica preto por autoplay.
      Se o portal tiver um canal geral (Design → youtube_canal_id), ele entra como
      1ª aba "AO VIVO". Troca de canal sem recarregar a página. --}}
<aside class="live-box live-leg" aria-label="Sessões ao vivo">
    <h2 class="rail-title rail-live"><span class="live-dot"></span> AO VIVO</h2>
    <div class="leg-tabs" role="tablist" aria-label="Canais ao vivo">
        {{#if @custom.youtube_canal_id}}<button class="leg-tab active" type="button" data-ch="{{@custom.youtube_canal_id}}" data-sched="">AO VIVO</button>{{/if}}
        <button class="leg-tab{{#unless @custom.youtube_canal_id}} active{{/unless}}" type="button" data-ch="UCIxlLEYzjWPLb_CXpc-e74w" data-sched="Sessões em geral de terça a quinta">ALMT</button>
        <button class="leg-tab" type="button" data-ch="UC-ZkSRh-7UEuwXJQ9UMCFJA" data-sched="Sessões em geral de terça a quinta">Câmara</button>
        <button class="leg-tab" type="button" data-ch="UCLgti7NuK0RuW9wty-fxPjQ" data-sched="Sessões em geral de terça a quinta">Senado</button>
        <button class="leg-tab" type="button" data-ch="UCNCoIaMma_H-aFP6rRNb56w" data-sched="Sessões em geral às terças e quartas">Câmara Cuiabá</button>
    </div>
    <div class="live-embed live-stage" id="legStage">
        <iframe class="live-frame" src="https://www.youtube.com/embed/live_stream?channel={{#if @custom.youtube_canal_id}}{{@custom.youtube_canal_id}}{{else}}UCIxlLEYzjWPLb_CXpc-e74w{{/if}}&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3&enablejsapi=1&origin={{@site.url}}"
            title="Prévia da transmissão ao vivo" loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
    <p class="live-sched" id="legSched">{{#unless @custom.youtube_canal_id}}Sessões em geral de terça a quinta{{/unless}}</p>
    <a class="live-yt-fallback" id="legLink" href="https://www.youtube.com/channel/{{#if @custom.youtube_canal_id}}{{@custom.youtube_canal_id}}{{else}}UCIxlLEYzjWPLb_CXpc-e74w{{/if}}/live" target="_blank" rel="noopener">Ver a agenda de sessões no YouTube ↗</a>
</aside>
<script>
(function () {
    var frame = document.querySelector('#legStage .live-frame');
    var sched = document.getElementById('legSched'), link = document.getElementById('legLink');
    if (!frame) return;
    var tabs = document.querySelectorAll('.leg-tab');
    var origin = '{{@site.url}}';
    function embedSrc(ch) {
        return 'https://www.youtube.com/embed/live_stream?channel=' + encodeURIComponent(ch) +
            '&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3&enablejsapi=1&origin=' + encodeURIComponent(origin);
    }
    tabs.forEach(function (t) {
        t.addEventListener('click', function () {
            tabs.forEach(function (x) { x.classList.remove('active'); });
            t.classList.add('active');
            var ch = t.getAttribute('data-ch');
            frame.src = embedSrc(ch);
            if (sched) sched.textContent = t.getAttribute('data-sched') || '';
            if (link) link.href = 'https://www.youtube.com/channel/' + encodeURIComponent(ch) + '/live';
        });
    });
})();
</script>
