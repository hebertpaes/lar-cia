{{!-- Um slide do hero. Usado dentro de {{#foreach slides}}. --}}
<article class="slide{{#if @first}} active{{/if}}" data-index="{{@index}}">
    <a class="slide-media" href="{{url}}">
        <span class="card-media-fallback big">{{@site.title}}</span>
        {{#if feature_image}}<img src="{{img_url feature_image size="xl"}}" alt="{{title}}" onerror="this.remove()" />{{/if}}
    </a>
    <div class="slide-caption">
        {{#primary_tag}}<a class="card-kicker big" href="{{url}}">{{name}}</a>{{/primary_tag}}
        <h2 class="slide-title"><a href="{{url}}">{{title}}</a></h2>
        <p class="slide-excerpt">{{excerpt words="26"}}</p>
    </div>
</article>
