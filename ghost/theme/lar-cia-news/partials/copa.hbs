{{!-- Bloco Copa do Mundo: resultados ao vivo (preenchido pelo JS via API).
      Configure em Design: copa_ativa, copa_api. Atualiza sozinho e tem
      fallback (link da CazéTV) se a fonte falhar. --}}
{{#if @custom.copa_ativa}}
<section class="copa container" data-api="{{@custom.copa_api}}" data-canal="{{#if @custom.youtube_canal}}{{@custom.youtube_canal}}{{else}}https://www.youtube.com/@CazeTV/live{{/if}}">
    <div class="section-head">
        <h2 class="section-title">⚽ Copa do Mundo</h2>
        <a class="section-more" href="{{#if @custom.youtube_canal}}{{@custom.youtube_canal}}{{else}}https://www.youtube.com/@CazeTV/live{{/if}}" target="_blank" rel="noopener">Ao vivo na CazéTV →</a>
    </div>
    <div class="copa-grid" id="copaGrid"><div class="copa-loading">Carregando jogos…</div></div>
</section>
{{/if}}
