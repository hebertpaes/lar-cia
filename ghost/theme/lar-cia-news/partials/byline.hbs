{{!-- Linha de autoria + data + tempo de leitura. --}}
<div class="byline">
    {{#if primary_author}}
        <a class="byline-author" href="{{primary_author.url}}">
            {{#if primary_author.profile_image}}
                <img src="{{img_url primary_author.profile_image size="xs"}}" alt="{{primary_author.name}}" />
            {{/if}}
            <span>{{primary_author.name}}</span>
        </a>
    {{/if}}
    <time class="byline-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD/MM/YYYY HH:mm"}}</time>
    <span class="byline-rt">{{reading_time minute="1 min" minutes="% min"}} <span class="rt-state" data-lendo="lendo" data-lido="lido">lendo</span></span>
</div>
