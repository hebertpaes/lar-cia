{{!< default}}

<div class="container author-wrap">
    <header class="author-head">
        {{#author}}{{#if profile_image}}<img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" />{{/if}}{{/author}}
        <div>
            <span class="card-kicker big">Colunista</span>
            <h1 class="author-name">{{#author}}{{name}}{{/author}}</h1>
            {{#author}}{{#if bio}}<p class="author-bio">{{bio}}</p>{{/if}}{{/author}}
        </div>
    </header>

    <div class="archive-grid">
        {{#foreach posts}}
            {{> article-card size="compact"}}
        {{else}}
            <p class="section-empty">Nenhuma matéria deste autor ainda.</p>
        {{/foreach}}
    </div>

    {{> pagination}}
</div>
