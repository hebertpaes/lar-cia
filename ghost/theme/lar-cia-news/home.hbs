{{!< default}}

{{!-- ===== Topo: slider + vídeo (Ao Vivo) ao lado ===== --}}
<section class="hero-row container">
    {{> hero-slider}}
    <aside class="hero-live" id="live">
        {{> live}}
        {{> ad zone="video" filter="tag:hash-ad-video" limit="6"}}
    </aside>
</section>

{{!-- ===== Colunas (3, só conteúdo): Mais lidas · Curtinhas · Vídeos =====
      Ficam logo abaixo do topo, coladas ao herói (não mais depois das faixas). --}}
<section class="columns container">
    {{> most-read}}
    {{> curtinhas}}
    {{> videos}}
</section>

{{!-- ===== Últimas notícias ===== --}}
<div class="container sections">
    <section class="section-block">
        <div class="section-head"><h2 class="section-title"><a href="{{@site.url}}/">Últimas notícias</a></h2></div>
        <div class="section-grid">
            {{!-- Mesma ordem da capa; pula as que já saem no slider (as primeiras
                  slides_home, seja qual for o valor 3–10) comparando a posição com
                  {{#match}} → sem repetição nem buraco, sem depender de `from`. --}}
            {{#get "posts" filter="tag:-hash-ad" limit="13" order="featured desc, published_at desc" as |recent|}}
                {{#foreach recent}}{{#match @number ">" @custom.slides_home}}{{> article-card size="compact"}}{{/match}}{{/foreach}}
            {{/get}}
        </div>
    </section>
</div>

{{!-- ===== Copa do Mundo + Política (faixas de conteúdo, fora do topo) ===== --}}
{{> copa}}
{{> politica-stats}}

{{!-- ===== Demais editorias ===== --}}
<div class="container sections">
    {{> section-block slug="cidades"      titulo="Cidades"             filter="tag:cidades+tag:-hash-ad"}}
    {{> section-block slug="policia"      titulo="Polícia"             filter="tag:policia+tag:-hash-ad"}}

    {{> ad zone="inarticle" filter="tag:hash-ad-inarticle" limit="6"}}

    {{> section-block slug="economia"     titulo="Economia"            filter="tag:economia+tag:-hash-ad"}}
    {{> section-block slug="agro"         titulo="Agro"                filter="tag:agro+tag:-hash-ad"}}
    {{> section-block slug="brasil-mundo" titulo="Brasil &amp; Mundo"  filter="tag:brasil-mundo+tag:-hash-ad"}}
    {{> section-block slug="imoveis"      titulo="Imóveis"             filter="tag:imoveis+tag:-hash-ad"}}
</div>

