{{!< default}}

{{!-- ===== Slider principal (até 10, Featured fixados) ===== --}}
{{> hero-slider}}

{{!-- ===== Últimas notícias + trilho lateral ===== --}}
<section class="lead container">
    <div class="lead-main">
        <div class="section-head"><h2 class="section-title"><a href="{{@site.url}}/noticias/">Últimas notícias</a></h2></div>
        <div class="lead-secondary">
            {{#get "posts" filter="tag:-hash-ad" limit="6" order="published_at desc" as |recent|}}
                {{#foreach recent}}{{> article-card size="compact"}}{{/foreach}}
            {{/get}}
        </div>
    </div>

    <div class="lead-rail">
        {{> live}}
        {{> videos}}
        {{> most-read}}
        {{> ad zone="sidebar" filter="tag:hash-ad-sidebar" limit="1"}}
    </div>
</section>

{{!-- ===== Editorias (configuráveis em package.json → editorias_home) ===== --}}
<div class="container sections">
    {{> section-block slug="politica"     titulo="Política"        filter="tag:politica+tag:-hash-ad"}}
    {{> section-block slug="cidades"       titulo="Cidades"         filter="tag:cidades+tag:-hash-ad"}}

    {{> ad zone="inarticle" filter="tag:hash-ad-inarticle" limit="1"}}

    {{> section-block slug="policia"       titulo="Polícia"         filter="tag:policia+tag:-hash-ad"}}
    {{> section-block slug="economia"      titulo="Economia"        filter="tag:economia+tag:-hash-ad"}}
    {{> section-block slug="agro"          titulo="Agro"            filter="tag:agro+tag:-hash-ad"}}
    {{> section-block slug="brasil-mundo"  titulo="Brasil &amp; Mundo" filter="tag:brasil-mundo+tag:-hash-ad"}}
    {{> section-block slug="imoveis"       titulo="Imóveis"         filter="tag:imoveis+tag:-hash-ad"}}
</div>

{{> sources}}
{{> newsletter}}
