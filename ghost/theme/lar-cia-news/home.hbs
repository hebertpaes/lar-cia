{{!< default}}

{{!-- ===== Bloco principal: manchete + chamadas + trilho lateral ===== --}}
<section class="lead container">
    <div class="lead-main">
        {{#get "posts" filter="tag:-hash-ad" limit="5" order="published_at desc" as |front|}}
            {{#foreach front}}
                {{#if @first}}
                    <article class="hero-lead">
                        <a class="hero-media" href="{{url}}">
                            {{#if feature_image}}<img src="{{img_url feature_image size="xl"}}" alt="{{title}}" />{{else}}<span class="card-media-fallback big">LAR&amp;CIA</span>{{/if}}
                            {{#if @custom.mostrar_chip_demo}}{{#has tag="hash-demo"}}<span class="chip-demo">DEMO</span>{{/has}}{{/if}}
                        </a>
                        <div class="hero-text">
                            {{#primary_tag}}<a class="card-kicker big" href="{{url}}">{{name}}</a>{{/primary_tag}}
                            <h1 class="hero-title"><a href="{{url}}">{{title}}</a></h1>
                            <p class="hero-excerpt">{{excerpt words="32"}}</p>
                            <div class="card-meta">{{#if primary_author}}<span>{{primary_author.name}}</span> · {{/if}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD/MM/YYYY HH:mm"}}</time></div>
                        </div>
                    </article>
                {{/if}}
            {{/foreach}}
            <div class="lead-secondary">
                {{#foreach front}}
                    {{#unless @first}}
                        {{> article-card size="compact"}}
                    {{/unless}}
                {{/foreach}}
            </div>
        {{/get}}
    </div>

    <div class="lead-rail">
        {{> most-read}}
        {{> ad zone="sidebar" filter="tag:hash-ad-sidebar" limit="1"}}
    </div>
</section>

{{!-- ===== Editorias (configuráveis em package.json → editorias_home) ===== --}}
<div class="container sections">
    {{> section-block slug="politica"     titulo="Política"        filter="tag:politica+tag:-hash-ad"}}
    {{> section-block slug="cidades"       titulo="Cidades"         filter="tag:cidades+tag:-hash-ad"}}

    {{> ad zone="inarticle" filter="tag:hash-ad-inarticle" limit="1"}}

    {{> section-block slug="policia"       titulo="Polícia"         filter="tag:policia+tag:-hash-ad"}}
    {{> section-block slug="economia"      titulo="Economia"        filter="tag:economia+tag:-hash-ad"}}
    {{> section-block slug="agro"          titulo="Agro"            filter="tag:agro+tag:-hash-ad"}}
    {{> section-block slug="brasil-mundo"  titulo="Brasil &amp; Mundo" filter="tag:brasil-mundo+tag:-hash-ad"}}
    {{> section-block slug="imoveis"       titulo="Imóveis"         filter="tag:imoveis+tag:-hash-ad"}}
</div>

{{> sources}}
{{> newsletter}}
