<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{meta_title}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />

    <style>:root{
        {{#if @site.accent_color}}--brand: {{@site.accent_color}};{{/if}}
        {{#if @site.heading_font}}--gh-font-heading: {{@site.heading_font}};{{/if}}
        {{#if @site.body_font}}--gh-font-body: {{@site.body_font}};{{/if}}
    }</style>

    {{ghost_head}}
</head>
<body class="{{body_class}}">
    {{> site-header}}

    <main id="site-main" class="site-main">
        {{{body}}}
    </main>

    {{> site-footer}}

    <a class="fab-whats" href="https://wa.me/5565999900005?text=Olá%20Hebert!%20Vim%20pelo%20site%20LAR%20%26%20CIA."
       target="_blank" rel="noopener" aria-label="WhatsApp">💬</a>

    <script src="{{asset "js/main.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
