{{!< default}}

{{#post}}
<article class="post container">
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-sub">{{custom_excerpt}}</p>{{/if}}
    </header>

    {{#if feature_image}}
        <img class="post-hero" src="{{img_url feature_image size="xl"}}" alt="{{title}}" />
    {{/if}}

    <div class="gh-content">
        {{content}}
    </div>

    <div class="post-cta">
        <a class="btn-primary" target="_blank" rel="noopener"
           href="https://wa.me/5565999900005?text=Olá%20Hebert!%20Tenho%20interesse%20em%20{{encode title}}.">💬 Tenho interesse</a>
        <a class="btn-outline" href="{{@site.url}}/financiamento/">Simular financiamento</a>
    </div>
</article>
{{/post}}
