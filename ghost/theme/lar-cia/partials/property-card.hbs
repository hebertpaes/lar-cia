<article class="card" data-search="{{title}} {{custom_excerpt}}">
    <a class="card-link" href="{{url}}">
        <div class="card-media">
            {{#if feature_image}}
                <img class="card-img" src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{title}}" />
            {{else}}
                <div class="img-fallback">🏠</div>
            {{/if}}
            {{#has tag="#verificado"}}<span class="badge-verified">✓ Verificado</span>{{/has}}
            {{#primary_tag}}<span class="badge-purpose">{{name}}</span>{{/primary_tag}}
        </div>
        <div class="card-body">
            <h3 class="card-title">{{title}}</h3>
            <p class="card-info">{{custom_excerpt}}</p>
        </div>
    </a>
</article>
