{{!< default}}

<section class="section-head center container" style="padding-top:48px">
    <h2>Do blog</h2>
    <p class="section-sub">Guias, análises e novidades do mercado imobiliário de Mato Grosso.</p>
</section>

<main class="container">
    <div class="blog-grid">
        {{#foreach posts}}
            <article class="blog-card">
                <a href="{{url}}">
                    <div class="blog-media">
                        {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" loading="lazy" alt="{{title}}" />{{/if}}
                    </div>
                    <div class="blog-content">
                        <div class="blog-tags">{{#foreach tags visibility="public"}}<span class="blog-tag">{{name}}</span>{{/foreach}}</div>
                        <h3>{{title}}</h3>
                        <p>{{excerpt}}</p>
                    </div>
                </a>
            </article>
        {{/foreach}}
    </div>
    {{pagination}}
</main>
