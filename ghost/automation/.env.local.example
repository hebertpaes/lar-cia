# Copie para ghost/automation/.env.local e preencha com as SUAS chaves (NOVAS,
# depois de rotacionar). Este arquivo .env.local é gitignored — nunca vai pro repo.

# --- IA que edita as matérias ---
# Claude (Anthropic) — "sua própria API":
IA_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
IA_PROVIDER=anthropic
# IA_MODEL=claude-3-5-haiku-latest
#
# ...ou OpenAI-compatível (deixe IA_PROVIDER vazio ou =openai):
# IA_API_KEY=sk-xxxxxxxx
# IA_MODEL=gpt-4o-mini
#
# ...ou via OpenClaw / AIMLAPI (endpoint compatível com OpenAI — só apontar a URL):
# IA_PROVIDER=openai
# IA_API_URL=https://api.aimlapi.com/v1/chat/completions   # ou o endpoint do SEU OpenClaw
# IA_API_KEY=sua-chave-aimlapi-ou-openclaw
# IA_MODEL=openclaw                                         # o id do modelo no seu provedor

# --- Publicação (Admin API Key de cada portal: id:secret) ---
HOJEMT_ADMIN_KEY=id:secret
ODIAPOLITICO_ADMIN_KEY=id:secret
PACUNEWS_ADMIN_KEY=id:secret
