# Caddy — HTTPS automático (Let's Encrypt) e roteamento por domínio.
# Aponte os DNS (A/AAAA) dos domínios para o IP da VM ANTES de subir.

hojemt.com.br, www.hojemt.com.br {
	reverse_proxy ghost-hojemt:2368
	encode zstd gzip
}

odiapolitico.com.br, www.odiapolitico.com.br {
	reverse_proxy ghost-odiapolitico:2368
	encode zstd gzip
}

pacunews.com.br, www.pacunews.com.br {
	reverse_proxy ghost-pacunews:2368
	encode zstd gzip
}

# Site de comandos/prompts (estático), servido de ./site
openclaw.ai {
	root * /srv/openclaw
	file_server
	encode zstd gzip
}

# Comenta — site da agência digital (estático), servido de ./comenta
comenta.com.br, www.comenta.com.br {
	root * /srv/comenta
	file_server
	encode zstd gzip
}
